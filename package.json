{
  "name": "kufar-currencies",
  "type": "module",
  "scripts": {
    "test": "vitest run --coverage",
    "format": "prettier --write 'src/lib/**/*.js' 'src/content/**/*.js' 'src/background.js' 'src/popup/**/*.js' 'scripts/**/*.mjs' 'tests/**/*.js' 'manifest.json'",
    "format:check": "prettier --check 'src/lib/**/*.js' 'src/content/**/*.js' 'src/background.js' 'src/popup/**/*.js' 'scripts/**/*.mjs' 'tests/**/*.js' 'manifest.json'",
    "package:chrome": "node scripts/build-chrome.mjs",
    "package:firefox": "node scripts/build-firefox.mjs",
    "package": "npm run package:chrome && npm run package:firefox"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
        "prettier": "^3.9.6",
    "vitest": "^4.1.11"
  }
}
